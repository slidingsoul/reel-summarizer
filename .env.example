# SocialKit API (primary transcription provider)
# Get your API key from https://www.socialkit.dev
SOCIALKIT_API_KEY=your_socialkit_api_key_here

# Supadata API (fallback transcription provider, used only when SocialKit quota/credits are exhausted)
# Get your API key from https://dash.supadata.ai
SUPADATA_API_KEY=your_supadata_api_key_here

# LLM API (provider-agnostic, OpenAI-compatible chat completions)
# Point at any provider: OpenRouter, OpenAI, or a local server (Ollama, LM Studio, vLLM, ...)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=mistralai/mistral-7b-instruct
#
# Examples:
#   OpenRouter (default): LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
#   OpenAI:               LLM_API_URL=https://api.openai.com/v1/chat/completions / LLM_MODEL=gpt-4o-mini
#   Ollama (local):       LLM_API_URL=http://localhost:11434/v1/chat/completions / LLM_MODEL=llama3.1
#                         (local servers usually accept any non-empty LLM_API_KEY, e.g. "ollama")
#
# Legacy fallbacks (still honored if the LLM_* vars are unset):
#   OPENROUTER_API_KEY, OPENROUTER_MODEL
# See all OpenRouter models at: https://openrouter.ai/docs/models

# Notion API
# Get your API key from https://www.notion.com/my-integrations
NOTION_TOKEN=your_notion_api_token_here

# Notion Page ID
# To get this, open your Notion page and copy the ID from the URL
# Example URL: https://notion.so/yourworkspace/abc123def456?v=xyz
# The ID is the 32-character string between '/' and '?'
NOTION_FOLDER_PAGE_ID=your_notion_page_id_here
