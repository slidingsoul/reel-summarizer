# SocialKit API
# Get your API key from https://www.socialkit.dev
SOCIALKIT_API_KEY=your_socialkit_api_key_here

# OpenRouter API
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (optional - defaults to free Mistral model)
# FREE MODELS:
#   mistralai/mistral-7b-instruct (default - fastest & free)
#   meta-llama/llama-2-7b-chat (free)
#   openrouter/auto (cheapest available model)
# 
# PAID MODELS (better quality):
#   openai/gpt-4-turbo-preview
#   anthropic/claude-3-opus
#   google/gemini-pro
#
# See all models at: https://openrouter.ai/docs/models
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Notion API
# Get your API key from https://www.notion.com/my-integrations
NOTION_TOKEN=your_notion_api_token_here

# Notion Page ID
# To get this, open your Notion page and copy the ID from the URL
# Example URL: https://notion.so/yourworkspace/abc123def456?v=xyz
# The ID is the 32-character string between '/' and '?'
NOTION_FOLDER_PAGE_ID=your_notion_page_id_here
